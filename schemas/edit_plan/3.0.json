{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oleg3479881328-code/AI-Handoff-Builder/schemas/edit_plan/3.0.json",
  "title": "Edit Plan 3.0",
  "description": "Creative/timeline intent for AI-generated edit plans. DaVinci-first, renderer-neutral.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "handoff_id",
    "handoff_sha256",
    "canvas",
    "timebase",
    "assets",
    "visual_items",
    "renderer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_plan_id": {
      "type": "string"
    },
    "patch_id": {
      "type": "string"
    },
    "base_plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "timebase": {
      "type": "object",
      "required": ["fps_num", "fps_den"],
      "properties": {
        "fps_num": {
          "type": "integer",
          "minimum": 1
        },
        "fps_den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "media_type"],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "enum": ["photo", "video", "audio"]
          },
          "original_name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "visual_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "asset_id",
          "media_type",
          "timeline_start_frame",
          "duration_frames",
          "source_in_us",
          "source_out_us",
          "source_audio_policy"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "enum": ["photo", "video"]
          },
          "timeline_start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "source_in_us": {
            "type": "integer",
            "minimum": 0
          },
          "source_out_us": {
            "type": "integer",
            "minimum": 0
          },
          "source_audio_policy": {
            "type": "string",
            "enum": ["discard", "keep", "duck_under_music", "replace"]
          },
          "transform": {
            "type": "object",
            "properties": {
              "scale_x": { "type": "number" },
              "scale_y": { "type": "number" },
              "position_x": { "type": "number" },
              "position_y": { "type": "number" },
              "rotation_degrees": { "type": "number" }
            },
            "additionalProperties": false
          },
          "crop": {
            "type": "object",
            "properties": {
              "left": { "type": "number", "minimum": 0 },
              "top": { "type": "number", "minimum": 0 },
              "right": { "type": "number", "minimum": 0 },
              "bottom": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "audio_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "audio_id",
          "role",
          "timeline_start_frame",
          "duration_frames"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "audio_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["music", "voiceover"]
          },
          "timeline_start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "source_in_us": {
            "type": "integer",
            "minimum": 0
          },
          "source_out_us": {
            "type": "integer",
            "minimum": 0
          },
          "gain": {
            "type": "number"
          },
          "fade_in_ms": {
            "type": "integer",
            "minimum": 0
          },
          "fade_out_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "text_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "text", "timeline_start_frame", "duration_frames"],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "timeline_start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "renderer": {
      "type": "object",
      "required": ["primary_renderer"],
      "properties": {
        "primary_renderer": {
          "type": "string",
          "const": "davinci"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "voiceover": {
      "type": "object",
      "required": ["spec_path"],
      "properties": {
        "spec_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
