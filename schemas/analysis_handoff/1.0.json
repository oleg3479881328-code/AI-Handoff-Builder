{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oleg3479881328-code/AI-Handoff-Builder/schemas/analysis_handoff/1.0.json",
  "title": "Analysis Handoff Manifest 1.0",
  "description": "Self-contained handoff package manifest for one-file Shotcut edit-plan generation.",
  "type": "object",
  "required": [
    "schema_version",
    "package_type",
    "project_id",
    "project_name",
    "handoff_id",
    "created_at",
    "entrypoint",
    "entrypoint_sha256",
    "project_brief",
    "project_brief_sha256",
    "output_contract",
    "output_contract_sha256",
    "expected_output_filename",
    "target_editor",
    "file_inventory",
    "content_hash",
    "asset_selection"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "package_type": {"type": "string", "const": "analysis_handoff"},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "handoff_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "entrypoint": {"type": "string", "const": "00_START_HERE.md"},
    "entrypoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_brief": {"type": "string", "const": "PROJECT_BRIEF.md"},
    "project_brief_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_contract": {"type": "string", "const": "OUTPUT_CONTRACT.md"},
    "output_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_output_filename": {"type": "string", "minLength": 1},
    "target_editor": {"type": "string", "const": "shotcut"},
    "file_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_selection": {
      "type": "object",
      "required": ["total_selected", "assets"],
      "properties": {
        "total_selected": {"type": "integer", "minimum": 0},
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "media_type", "status"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "media_type": {"type": "string", "enum": ["photo", "video", "audio"]},
              "original_name": {"type": "string"},
              "status": {
                "type": "string",
                "enum": ["included", "explicitly_excluded_by_declared_policy", "failed_with_error"]
              },
              "error_message": {"type": "string"},
              "analysis_representations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "representation_type", "sha256", "size_bytes"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "representation_type": {
                      "type": "string",
                      "enum": ["resized_photo", "video_proxy", "video_keyframe", "contact_sheet", "metadata", "transcript"]
                    },
                    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                    "size_bytes": {"type": "integer", "minimum": 0}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
